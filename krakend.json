          "strategy": "ip"
        }
      },
      "input_headers": [
        "Content-Type",
        "Accept",
        "Authorization",
        "authorization"
      ],
      "backend": [
        {
          "host": ["http://auth:9000"],
          "url_pattern": "/api/v1/auth/login",
          "encoding": "no-op",
          "sd": "static",
          "disable_host_sanitize": true,
          "extra_config": {
            "backend/http": {
              "return_error_details": "backend_alias",
              "status": [200, 201, 400, 401, 403, 404, 406, 409, 429, 500]
